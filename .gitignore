# ── IDE / OS ──
.claude/
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Dependencies ──
node_modules/

# ── Environment / Secrets ──
.env
.env.*
!.env.example

# ── Build output (generated by build.js / Capacitor) ──
dist/

# ── Large binary models ──
# Root models/ is for local training — not tracked
models/
# www/models/ IS tracked — needed for GitHub Pages deploy
# Only the production v6 model is force-added (see git add -f)
*.onnx.data

# ── Training data & videos (local-only) ──
tools/training-videos/
training/
training_data/
*.mp4
*.mov

# ── Debug / scratch files ──
debug-*.html
Download.mp4
auto-sync.js

# ── Eval workspace (local-only test videos + extracted frames) ──
_eval/
www/_audit/

# ── Capacitor generated ──
android/app/build/
android/.gradle/

# Local eval artifacts (frames, detections, GT sheets) — hundreds of MB
scratch/

# Local test videos served via tunnel, not for the repo
www/_test_video.mp4
www/_pullups.mp4
www/_test2.mp4

# Workflow edits need a token with workflow scope — keep local tweaks untracked
.github/workflows/*.disabled
