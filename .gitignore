# ── IDE / OS ──
.claude/
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Dependencies ──
node_modules/

# ── Environment / Secrets ──
.env
.env.*
!.env.example

# ── Build output (generated by build.js / Capacitor) ──
dist/

# ── Large binary models ──
# models/ holds local training outputs — untracked EXCEPT the one
# production model, which must live in the repo so CI can build www/
# (www/ itself is generated and untracked).
models/*
!models/basketball_yolox_tiny_v6_polished.onnx
!models/basketball_yolox_tiny_v7m5.onnx
!models/basketball_yolox_tiny_v7m5_fp16.onnx
!models/basketball_yolox_tiny_v7b1_fp16.onnx
*.onnx.data

# ── Training data & videos (local-only) ──
tools/training-videos/
training/
training_data/
*.mp4
*.mov

# ── Debug / scratch files ──
debug-*.html
Download.mp4
auto-sync.js

# ── Eval workspace (local-only test videos + extracted frames) ──
_eval/
www/_audit/

# ── Capacitor generated ──
android/app/build/
android/.gradle/

# Local eval artifacts (frames, detections, GT sheets) — hundreds of MB
scratch/

# Local test videos served via tunnel, not for the repo

# Workflow edits need a token with workflow scope — keep local tweaks untracked
.github/workflows/*.disabled
www/
